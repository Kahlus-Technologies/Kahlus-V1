  "transition_detection": {
    "task": "binary: does the scored stage change within h seconds",
    "metric": "ROC AUC and average precision; accuracy would be dominated by the base rate since transitions are rare",
    "reference": "stage_only -- transition probability depends on the current stage, so beating chance is too easy a bar",
    "label_noise_ceiling": {
      "overall_kappa": 0.76,
      "per_stage_kappa": {
        "W": 0.7,
        "N1": 0.24,
        "N2": 0.57,
        "N3": 0.57,
        "REM": 0.69
      },
      "raw_epoch_agreement": 0.82,
      "sources": [
        "Lee YJ, Lee JY, Cho JH, Choi JH. Interrater reliability of sleep stage scoring: a meta-analysis. J Clin Sleep Med. 2022;18(1):193-202.",
        "Danker-Hopfe H, et al. Interrater reliability for sleep scoring according to the Rechtschaffen & Kales and the new AASM standard. J Sleep Res. 2009;18(1):74-84."
      ],
      "implication": "a transition is defined by two labels, so at ~0.82 per-epoch agreement roughly a third of scored transitions may be scorer disagreement rather than physiology; AUC against these labels is bounded well below 1"
    },
